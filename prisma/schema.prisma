generator client {
  provider        = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── Better Auth required models — field names are exact, don't rename them ───

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean                 // ← was missing from your migration
  image         String?
  createdAt     DateTime
  updatedAt     DateTime                // ← was missing from your migration

  sessions  Session[]
  accounts  Account[]
  projects  Project[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime                    // ← was missing
  updatedAt DateTime                    // ← was missing
  ipAddress String?                     // ← was missing
  userAgent String?                     // ← was missing
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?         // ← was missing
  refreshToken          String?         // ← was missing
  idToken               String?         // ← was missing
  accessTokenExpiresAt  DateTime?       // ← was missing
  refreshTokenExpiresAt DateTime?       // ← was missing
  scope                 String?         // ← was missing
  password              String?         // ← was missing
  createdAt             DateTime        // ← was missing
  updatedAt             DateTime        // ← was missing

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

// ── App models ────────────────────────────────────────────────────────────────

model Project {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  website     String?
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  changelogs Changelog[]

  @@map("project")
}

model Changelog {
  id        String   @id @default(cuid())
  title     String
  slug      String
  content   String   @db.Text
  status    Status   @default(DRAFT)
  category  Category @default(FEATURE)
  createdAt DateTime @default(now())
  projectId String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, slug])
  @@map("changelog")
}

enum Status {
  DRAFT
  PUBLISHED
}

enum Category {
  FEATURE
  FIX
  IMPROVEMENT
  SECURITY
  BREAKING
  DEPRECATED
  REMOVED
}
